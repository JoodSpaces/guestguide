# Copy to .env.local and fill in values. Never commit .env.local.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex key for AES-256-GCM (door codes, wifi passwords, phone numbers)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Pepper added before SHA-256 hashing of stay tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_PEPPER=

# Admin auth (HMAC cookie signing — required, throws if absent)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Integration ID from your Paymob dashboard → Developers → Payment Integrations
PAYMOB_INTEGRATION_ID=
# iFrame ID from your Paymob dashboard → Developers → iFrames
PAYMOB_IFRAME_ID=

# WhatsApp Business Platform
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Channel manager
CHANNEL_MANAGER_API_KEY=
CHANNEL_MANAGER_WEBHOOK_SECRET=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Notifications
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=

# Push notifications (VAPID keys)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_KEY=

# Analytics / Errors
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cron (Vercel Cron job auth)
CRON_SECRET=
