# Copy to .env.local and fill in values. Never commit .env.local.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex key for AES-256-GCM (door codes, wifi passwords, phone numbers)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Pepper added before SHA-256 hashing of stay tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_PEPPER=

# Paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=

# WhatsApp Business Platform
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Channel manager
CHANNEL_MANAGER_API_KEY=
CHANNEL_MANAGER_WEBHOOK_SECRET=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Notifications
RESEND_API_KEY=

# Analytics / Errors
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Cron (Vercel Cron job auth)
CRON_SECRET=
